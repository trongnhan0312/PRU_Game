    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[0].dialogText
      value: "Nova, anh \u0111\xE3 v\u01B0\u1EE3t qua Slime, nh\u01B0ng \u0111\xE2y
        m\u1EDBi l\xE0 th\u1EED th\xE1ch th\u1EF1c s\u1EF1. Sai l\u1EA7m \u0111\u1ED3ng
        ngh\u0129a v\u1EDBi c\xE1i ch\u1EBFt."
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[1].dialogText
      value: "V\u1EADy l\u1EA7n n\xE0y k\u1EBB th\xF9 l\xE0 ai?"
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[2].dialogText
      value: "Samurai Devil ,m\u1ED9t samurai tr\u1ED5i d\u1EADy t\u1EEB th\u1EDDi
        c\u1ED5 \u0111\u1EA1i, c\xF3 thanh ki\u1EBFm c\u1EE7a qu\u1EF7"
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[3].dialogText
      value: "V\xE0 gi\u1EDD \u0111\xE2y, h\u1EAFn \u0111ang canh gi\u1EEF vi\xEAn
        Eden Relic th\u1EE9 hai. N\u1EBFu mu\u1ED1n c\xF3 n\xF3, c\u1EADu ph\u1EA3i
        \u0111\xE1nh b\u1EA1i h\u1EAFn!"
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[4].dialogText
      value: "V\u1EADy ra vi\xEAn Eden Relic th\u1EE9 hai \u0111ang n\u1EB1m trong
        tay h\u1EAFn\u2026 \u0110\u01B0\u1EE3c th\xF4i! Ta s\u1EBD \u0111\xE1nh b\u1EA1i
        Samurai Devil v\xE0 l\u1EA5y l\u1EA1i n\xF3!"
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[5].dialogText
      value: "\u0110\u1EEBng \u0111\u1EC3 n\xF3 c\xF3 c\u01A1 h\u1ED9i \u0111\xE1nh
        b\u1EA1i c\u1EADu. Ch\xFAc may m\u1EAFn.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[6].dialogText
      value: "T\xF4i s\u1EBD kh\xF4ng l\xE0m anh th\u1EA5t v\u1ECDng."
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[7].dialogText
      value: "V\u1EADy t\xF4i s\u1EBD l\xEAn \u0111\u01B0\u1EDDng ngay!"
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
