    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[0].dialogText
      value: "Nova, anh \u0111\xE3 l\xE0m t\u1ED1t. Nh\u01B0ng \u0111\xE2y l\xE0
        n\u01A1i nguy hi\u1EC3m nh\u1EA5t, n\u01A1i c\xF3 s\u1EF1 xu\u1EA5t hi\u1EC7n
        c\u1EE7a  Dark Wizard, m\u1ED9t ph\xF9 th\u1EE7y b\xF3ng t\u1ED1i \xE1c \u0111\u1ED9c"
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[1].dialogText
      value: "Dark Wizard\u2026 t\xF4i nh\u1EA5t \u0111\u1ECBnh s\u1EBD \u0111\xE1nh
        b\u1EA1i h\u1EAFn"
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[2].dialogText
      value: "Chi\u1EBFn binh nh\u1ECF b\xE9 mang gi\u1EA5c m\u01A1 c\u1EE7a nh\xE2n
        lo\u1EA1i? Th\u1EADt \u0111\xE1ng th\u01B0\u01A1ng h\u1EA1i."
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[3].dialogText
      value: "L\u1ED9 di\u1EC7n \u0111i!, ta s\u1EBD ti\xEAu di\u1EC7t ng\u01B0\u01A1i"
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[4].dialogText
      value: "T\u1ED1t l\u1EAFm, Nova. K\u1EBFt th\xFAc chuy\u1EC7n n\xE0y \u0111i!"
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
      propertyPath: dialogEntries.Array.data[5].dialogText
      value: "H\xF4m nay\u2026 ta s\u1EBD k\u1EBFt th\xFAc t\u1EA5t c\u1EA3!"
      objectReference: {fileID: 0}
    - target: {fileID: 2210206556098237478, guid: 2cf86c9f64ed9a3439fcbca8df60e375, type: 3}
